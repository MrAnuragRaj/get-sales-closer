# Growth Engine — Production Environment Variables
# Copy to .env and fill in real values before deploying.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase connection string (Transaction mode pooler recommended for Railway)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte hex key for encrypting platform credentials at rest
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GROWTH_ENCRYPTION_KEY=

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=production

# ── Platform Flags ────────────────────────────────────────────────────────────
# Set to true only when platform credentials are configured and tested
PLATFORM_LINKEDIN_ENABLED=true
PLATFORM_INSTAGRAM_ENABLED=false
PLATFORM_X_ENABLED=false

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-engine.railway.app/auth/linkedin/callback

# ── Meta (Instagram) OAuth ────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-engine.railway.app/auth/meta/callback

# ── X (Twitter) OAuth ─────────────────────────────────────────────────────────
# Leave blank until X is activated
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://your-engine.railway.app/auth/x/callback

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Internal Security ─────────────────────────────────────────────────────────
# Random secret for /internal/* endpoints (cron-only, never exposed to browser)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SWEEP_SECRET=

# ── Worker Tuning ─────────────────────────────────────────────────────────────
# How many opportunities the scoring worker processes per invocation
SCORING_WORKER_BATCH_SIZE=10

# ── Feature Flags (default OFF — flip to activate, flip back to revert) ───────
# Prioritise scoring queue by relationship strength (engaged authors first)
GROWTH_GRAPH_PRIORITY_ENABLED=false

# Adaptive scoring thresholds based on execution outcomes
LEARNING_LOOP_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
